{
  "name": "@rigline/plugin-api",
  "version": "1.0.0-alpha.10",
  "description": "The context, manifest and identifier types a Rigline plugin is written against",
  "keywords": [
    "rigline",
    "claude-code",
    "vscode",
    "plugin",
    "plugin-api"
  ],
  "homepage": "https://github.com/Rigline/Rigline#readme",
  "bugs": "https://github.com/Rigline/Rigline/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rigline/Rigline.git",
    "directory": "packages/plugin-api"
  },
  "author": "Lionell Pack",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "!dist/**/*.map",
    "schema"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "default": "./dist/ui/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.build.json && tsc -p tsconfig.types.json && node scripts/write-schema.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "react": "^19.3.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "^19.3.0"
  }
}
