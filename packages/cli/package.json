  "description": "Install, update and develop plugins for the Claude Code VS Code extension",
  "keywords": [
    "rigline",
    "claude-code",
    "vscode",
    "plugin",
    "cli"
  ],
  "homepage": "https://github.com/Rigline/Rigline#readme",
  "bugs": "https://github.com/Rigline/Rigline/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rigline/Rigline.git",
