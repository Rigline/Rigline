{
  "name": "@rigline/core",
  "version": "1.0.0-alpha.2",
  "description": "Harvest, codegen, injection and the update flow for Rigline, as a Node library",
  "keywords": [
    "rigline",
    "claude-code",
    "vscode",
    "plugin"
  ],
  "homepage": "https://github.com/Rigline/Rigline#readme",
  "bugs": "https://github.com/Rigline/Rigline/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rigline/Rigline.git",
    "directory": "packages/core"
  },
  "author": "Lionell Pack",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@rigline/plugin-api": "workspace:*"
  }
}
