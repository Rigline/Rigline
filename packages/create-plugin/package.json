{
  "name": "create-rigline-plugin",
  "version": "1.0.0-alpha.12",
  "description": "Scaffold a workspace for Claude Code VS Code extension plugins",
  "keywords": [
    "rigline",
    "claude-code",
    "vscode",
    "plugin",
    "scaffold",
    "create"
  ],
  "homepage": "https://github.com/Rigline/Rigline#readme",
  "bugs": "https://github.com/Rigline/Rigline/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rigline/Rigline.git",
    "directory": "packages/create-plugin"
  },
  "author": "Lionell Pack",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "template"
  ],
  "bin": {
    "create-rigline-plugin": "./dist/index.js"
  },
  "scripts": {
    "build": "node ../../scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@rigline/plugin-api": "workspace:*"
