{
  "$schema": "node_modules/@rigline/plugin-api/schema/manifest.json",
  "api": 1,
  "name": "session-id",
  "description": "The session's short id in the composer footer, and its full id and messaging address in Rigline's menu, each copied with a click.",
  "entry": "dist/index.js",
  "surfaces": ["editor", "sidebar"],
  "uses": {
    "tools": true,
    "session": true,
    "menu": true,
    "optional": {
      "messages": ["launch_claude"]
    }
  },
  "elements": {
    "short-id": {
      "title": "Session id",
      "placements": [{ "anchor": "footerSpacer", "at": "before" }, "rigRow"],
      "default": { "anchor": "footerSpacer", "at": "before" }
    },
    "full-id": {
      "title": "Full session id",
      "placements": ["rigRow"],
      "default": null
    },
    "address": {
      "title": "Messaging address",
      "placements": ["rigRow"],
      "default": null
    }
  }
}
