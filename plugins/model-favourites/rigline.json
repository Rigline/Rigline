{
  "$schema": "node_modules/@rigline/plugin-api/schema/manifest.json",
  "api": 1,
  "name": "model-favourites",
  "description": "Your usual model and effort combinations as one pill, a click each, and your default beside it, each highlighted while it is the one live.",
  "entry": "dist/index.js",
  "surfaces": ["editor", "sidebar"],
  "uses": {
    "models": true,
    "modelChoice": true,
    "menu": true,
    "settingsTab": true
  },
  "elements": {
    "favourites": {
      "title": "Model favourites",
      "placements": ["rigRow"],
      "default": "rigRow"
    },
    "default": {
      "title": "Default model",
      "placements": [
        "rigRow",
        {
          "anchor": "footerSpacer",
          "at": "before"
        }
      ],
      "default": "rigRow"
    }
  }
}
