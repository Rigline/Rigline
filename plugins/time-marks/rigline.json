{
  "$schema": "node_modules/@rigline/plugin-api/schema/manifest.json",
  "api": 1,
  "name": "time-marks",
  "description": "The time on every transcript entry, and a divider where the conversation crossed a day or paused.",
  "entry": "dist/index.js",
  "surfaces": ["editor", "sidebar"],
  "uses": {
    "anchors": ["transcriptRow"],
    "style": true,
    "transcript": true,
    "menu": true,
    "optional": {
      "anchors": ["itemTime"]
    }
  }
}
