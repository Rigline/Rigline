{
  "$schema": "node_modules/@rigline/plugin-api/schema/manifest.json",
  "api": 1,
  "name": "probe",
  "description": "Rigline's diagnostics panel. Renders every contributor's checks — the host's own under core, then each plugin's — as a small badge in the composer footer, and contributes the handful nothing else can run.",
  "entry": "dist/index.js",
  "uses": {
    "anchors": ["footerSpacer", "modelPill", "transcriptRow", "sessionListItem"],
    "messages": [
      "init",
      "request",
      "response",
      "rename_tab",
      "session_states_update",
      "update_session_state",
      "update_state",
      "io_message"
    ],
    "rewrites": {
      "rename_tab": ["title"]
    },
    "mount": true,
    "style": true,
    "transcript": true
  }
}
