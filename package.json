{
  "name": "rigline-workspace",
  "version": "2.0.1",
  "private": true,
  "type": "module",
  "description": "Plugin layer for the Claude Code VS Code extension",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rigline/Rigline.git"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r build && node scripts/bundle-assets.mjs",
    "rigline": "rigline-engine",
    "codegen": "rigline-engine codegen",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "release": "node scripts/release.mjs",
    "release:check": "node scripts/release-check.mjs",
    "release:finish": "node scripts/release-finish.mjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rigline/core": "workspace:*",
    "@types/node": "^26.5.1",
    "@types/semver": "^7.8.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "rolldown": "^1.2.8",
    "semver": "^7.8.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.0"
  }
}
