{
  "name": "rigline-workspace",
  "version": "1.0.0-alpha.0",
  "private": true,
  "type": "module",
  "description": "Plugin layer for the Claude Code VS Code extension",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "pnpm -r build",
    "codegen": "rigline codegen",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@types/node": "^26.5.1",
    "rigline": "workspace:*",
    "rolldown": "^1.2.8",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
